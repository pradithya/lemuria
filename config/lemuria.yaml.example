# Lemuria Configuration Example
# Copy this file to lemuria.yaml and customize for your environment
#
# Multiple Config Files:
# You can specify multiple config files that are merged in order:
#   lemuria -config base.yaml -config override.yaml
# Later files override values from earlier files.
#
# Environment Variable Override:
# All config values can be overridden via environment variables.
# Use double underscore (__) for hierarchy, single underscore for field names.
# Examples:
#   ARGOCD__TOKEN        -> argocd.token
#   ARGOCD__SERVER_URL   -> argocd.server_url
#   GITHUB__WEBHOOK_SECRET -> github.webhook_secret
#   SERVER__BASE_URL     -> server.base_url

server:
  # Port to listen on
  port: 4141
  # Host to bind to (0.0.0.0 for all interfaces)
  host: "0.0.0.0"
  # Base URL for OAuth callbacks (required if auth enabled)
  # Example: https://lemuria.example.com
  # Override with: SERVER__BASE_URL
  base_url: ""
  # Log level: debug, info, warn, error
  # Override with: SERVER__LOG_LEVEL
  log_level: "info"

github:
  # GitHub webhook secret for validating incoming webhooks
  # Override with: GITHUB__WEBHOOK_SECRET
  webhook_secret: ""

  # GitHub App ID
  # Override with: GITHUB__APP_ID
  app_id: 12345

  # Path to GitHub App private key file
  # Override with: GITHUB__APP_PRIVATE_KEY
  app_private_key: "/app/secrets/github-app.pem"

argocd:
  # Argo CD server URL
  # Override with: ARGOCD__SERVER_URL
  server_url: "https://argocd.example.com"

  # Argo CD API token
  # Override with: ARGOCD__TOKEN
  token: ""

  # Skip TLS verification (not recommended for production)
  insecure: false

redis:
  # Redis server address
  address: "localhost:6379"

  # Redis password (optional)
  # Override with: REDIS__PASSWORD
  password: ""

  # Redis database number
  db: 0

defaults:
  # Automatically run plan when PR is opened or updated
  autoplan: true

  # Require PR approval before allowing sync or rollback
  require_approval: false

  # Delete source branch after successful sync
  delete_source_branch: false

  # Automatically merge PR after all syncs succeed
  # When enabled, the PR will be merged using the specified merge_method
  auto_merge: false

  # Merge method for auto-merge: "squash", "merge", or "rebase"
  merge_method: "squash"

  # Repository allowlist - only process webhooks from these repos
  # Supports wildcards: "org/*" matches all repos in org
  # Empty list allows all repos
  allowed_repos:
    - "myorg/myrepo"
    - "myorg/infrastructure-*"
    # - "myorg/*"  # Allow all repos in myorg

# Authentication configuration (optional)
# Uncomment and configure to enable the web UI with SSO
auth:
  # Enable authentication (default: false)
  enabled: false

  # Secret for signing session cookies (required if auth enabled)
  # Generate with: openssl rand -hex 32
  # Override with: AUTH__SESSION_SECRET
  session_secret: ""

  # Session duration (default: 24h)
  session_ttl: 24h

  # Cookie settings
  cookie_domain: ""        # Leave empty for auto-detect
  cookie_secure: true      # Set to true for HTTPS

  # Default role for new users: "admin" or "user"
  default_role: "user"

  # GitHub OAuth configuration (optional)
  # Create OAuth App at: https://github.com/settings/developers
  github:
    # Override with: AUTH__GITHUB__CLIENT_ID
    client_id: ""
    # Override with: AUTH__GITHUB__CLIENT_SECRET
    client_secret: ""
    # Restrict to organization members (optional)
    # allowed_orgs:
    #   - "myorg"
    # Restrict to team members (optional)
    # allowed_teams:
    #   - "myorg/platform-team"

  # Generic OIDC configuration (optional)
  # Works with Okta, Auth0, Keycloak, Azure AD, etc.
  # oidc:
  #   name: "Company SSO"
  #   issuer_url: "https://login.example.com"
  #   client_id: ""      # Override with: AUTH__OIDC__CLIENT_ID
  #   client_secret: ""  # Override with: AUTH__OIDC__CLIENT_SECRET
  #   scopes:
  #     - "openid"
  #     - "profile"
  #     - "email"
  #   username_claim: "preferred_username"
  #   email_claim: "email"
  #   groups_claim: "groups"  # Optional: for group-based role assignment

  # Basic auth configuration (for local development only)
  # WARNING: Not recommended for production use
  # basic:
  #   users:
  #     - username: admin
  #       password: admin
  #       role: admin
  #     - username: user
  #       password: user
  #       role: user

  # Role assignments - first match wins
  # Patterns: exact email, wildcard (*@domain.com), @org/team (GitHub), group-name (OIDC)
  role_assignments:
    # Specific users
    - pattern: "admin@example.com"
      role: "admin"
    # Domain-based
    - pattern: "*@platform.example.com"
      role: "admin"
    # GitHub team
    # - pattern: "@myorg/platform-admins"
    #   provider: "github"
    #   role: "admin"
    # OIDC group
    # - pattern: "platform-admins"
    #   provider: "oidc"
    #   role: "admin"
